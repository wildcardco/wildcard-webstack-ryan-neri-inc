---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import house from '../assets/img/gbp-01-house.jpg';

const ways = [
  {
    title: 'Custom Home Builds',
    copy: 'At Neri, we believe your home should be an extension of you–supporting your everyday lifestyle, providing spaces for entertaining and making memories. Every homeowner is unique and your home should match. We’ll guide you through the entire process from design to completion to ensure your forever home is built with intention and care.',
  },
  {
    title: 'Room Renovations',
    copy: 'Sometimes a single room can transform the way your home feels. Whether it’s a kitchen, bathroom, or basement, we help reimagine your space so it functions beautifully and looks exactly how you want it to.',
  },
  {
    title: 'Home Additions',
    copy: 'Need more space but love where you live? Whether it’s an extra bedroom, a sunroom, or a new wing, we seamlessly expand your home so it grows with your family.',
  },
];

const steps = [
  ['Discovery Meeting', 'We start with a personalized consultation to understand your goals, dreams, and how your home needs to support your life. This is about more than square footage.'],
  ['Design Collaboration', 'If you don’t already have an architect, we’ll connect you with trusted partners and support you in developing plans. We stay involved throughout the design process to ensure your vision aligns with your budget and the build is set up for success.'],
  ['Permits & Planning', 'Once your plans are finalized, we take care of securing permits and coordinating with the city so you don’t have to worry about the red tape.'],
  ['Full-Service Project Management', 'We’re not just your builders, we’re your project managers. From start to finish, we’ll help you make selections that match your style and needs while keeping the process organized and on track.'],
  ['Ongoing Communication', 'You’ll always know where things stand. We provide regular updates, share timelines and milestones, and invite you to visit the site and see your future home take shape.'],
  ['In-House Team + Trusted Partners', 'Much of the work is done by our own experienced team. When we bring in subcontractors, they’re hand-selected for quality and reliability. It’s a true one-stop shop.'],
  ['Your Home, Revealed', 'Before the keys are handed over, we walk through every detail with you. With inspections complete and boxes checked, your dream home is ready—crafted with care and built to last.'],
];
---

<BaseLayout
  title="Custom Home Building | Neri, Inc."
  description="Custom home builds, room renovations, and home additions from Neri, Inc."
>
  <section class="grid bg-ink text-white lg:grid-cols-2">
    <Image
      src={house}
      alt="Two-story brick house with beige gables, a white garage door, and an arched front entry."
      widths={[480, 800, 1179]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="h-72 w-full object-cover lg:h-full"
    />
    <div class="px-4 py-16 lg:px-12">
      <p class="font-meta uppercase tracking-wide">Custom home building</p>
      <h1 class="mt-2 text-4xl">Custom Homes Without the Hassle.</h1>
      <p class="mt-4 text-lg">Your Vision. Our Craftsmanship. Built for Life.</p>
      <p class="mt-4 max-w-xl leading-7">
        We handle it all so you can watch your dream home come to life. Full-service construction management serving
        Crete, IL and surrounding cities.
      </p>
      <a
        href="/contact?type=build"
        class="mt-8 inline-block rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300"
      >
        Start your project
      </a>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl">Three ways we build with you</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          ways.map((way) => (
            <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
              <h3 class="text-xl">{way.title}</h3>
              <p class="mt-3 leading-7">{way.copy}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8">
        <a class="font-medium text-accent hover:underline" href="/view-homes">View Homes</a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl">Our process</h2>
    <p class="mt-2 font-meta">A stress-free experience from start to finish</p>
    <ol class="mt-8 space-y-6">
      {
        steps.map((step, index) => (
          <li class="grid gap-2 border-t border-rule pt-6 md:grid-cols-[8rem_1fr]">
            <p class="font-meta">Step {index + 1}</p>
            <div>
              <h3 class="text-xl">{step[0]}</h3>
              <p class="mt-2 leading-7">{step[1]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <CtaBand href="/contact?type=build" />
</BaseLayout>
