---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projectPhotos, projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props;
const photos = projectPhotos(project.slug);
const intro =
  project.slug === 'projectgallery'
    ? 'Every dream home starts with a vision. Maybe you picture an open-concept kitchen for family gatherings. Maybe you want a backyard oasis for summer nights. Or maybe you’re looking for a home that blends timeless style with modern function. Here, you’ll find a collection of our past custom homes and landscapes—each one unique, each one built to reflect the people who live there. Use this gallery to spark ideas, see the level of craftsmanship we deliver, and imagine what’s possible for your own project.'
    : 'Photos from this project, as published by Neri, Inc.';
---

<BaseLayout title={`${project.pageTitle} | Neri, Inc.`} description={`${project.pageTitle} photos from Neri, Inc.`}>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <p class="font-meta">
        <a class="hover:underline" href="/view-homes">View Homes</a>
      </p>
      <h1 class="mt-2 text-4xl">{project.pageTitle}</h1>
      <p class="mt-4 max-w-3xl leading-7">{intro}</p>
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-4 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    {
      photos.map((photo, index) => {
        const floorplan = /floorplan/i.test(photo.file);
        const alt = floorplan
          ? `Floor plan from the ${project.title} project page.`
          : index === 0
            ? project.alt
            : `Photo from the ${project.title} project.`;
        return (
          <a href={photo.file} class="block overflow-hidden rounded-lg bg-paper">
            <img src={photo.file} alt={alt} loading="lazy" class="h-56 w-full object-cover" />
          </a>
        );
      })
    }
  </section>
  <CtaBand />
</BaseLayout>
