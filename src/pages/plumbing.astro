---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  ['New Construction Plumbing', 'We handle all plumbing for our custom home builds. All designed and installed to meet your unique layout, budget, and long-term needs.'],
  ['Home Renovation & Additions', 'Adding on a bathroom? Remodeling your kitchen? We’ll upgrade or extend your plumbing to support your new space.'],
  ['Water Heaters & Tanks', 'Whether you\'re replacing an outdated unit or installing a new system, we ensure reliable access to hot water with quality equipment and expert installation.'],
  ['Sewer & Septic', 'We offer septic system installation and sewer line hookups that are safe, code-compliant, and built to last.'],
  ['System Upgrades for Older Homes', 'Older pipes can cause major issues. We evaluate and update aging plumbing systems to keep your home functioning safely and efficiently.'],
];
---

<BaseLayout
  title="Plumbing | Neri, Inc."
  description="In-house plumbing for new construction, renovations, water heaters, sewer, and septic from Neri, Inc."
>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <p class="font-meta uppercase tracking-wide">Plumbing</p>
      <h1 class="mt-2 max-w-3xl text-4xl">Reliable plumbing for every home</h1>
      <p class="mt-4 text-lg">No third-party vendors. No coordination stress.</p>
      <p class="mt-4 max-w-3xl leading-7">
        Just quality workmanship, managed by the same trusted team from start to finish.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="max-w-3xl space-y-4 text-lg leading-8">
      <p>
        Reliable plumbing is the backbone of any well-built home. Whether you’re building from scratch or updating an
        older system, our in-house team, serving Crete, IL and the surrounding area, ensures it’s done with care
        without the headaches of hiring out.
      </p>
      <p>
        At Neri, plumbing isn’t an afterthought. It’s one of the many ways we make your home project seamless. From new
        construction and home additions to water heaters, septic, and sewer systems, our licensed in-house plumbers
        are there from the start making sure everything behind the walls works just as beautifully as what’s in front
        of them.
      </p>
    </div>
    <h2 class="mt-12 text-3xl">Plumbing services</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        services.map((service) => (
          <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <h3 class="text-xl">{service[0]}</h3>
            <p class="mt-3 leading-7">{service[1]}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl">Why in-house plumbing matters</h2>
      <p class="mt-4 max-w-3xl leading-7">
        When you build or renovate with Neri, you won’t need to find a plumber or worry about juggling contractors. Our
        in-house team means fewer delays, better communication, and work that’s held to our high standards—because it’s
        all under one roof.
      </p>
      <figure class="mt-8 max-w-3xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
        <p class="font-heading text-lg">
          They provided their expertise and got everything fixed and functioning properly the way it should be.
        </p>
        <blockquote class="mt-3 leading-7">
          Neri, Inc. came to my home to install a new water [softener] but in doing so found other issues that were
          needing to be fixed.
        </blockquote>
        <figcaption class="mt-4 font-meta">— Sandra S.</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand href="/contact?type=plumbing" />
</BaseLayout>
