---
import {
  email,
  emailHref,
  facebook,
  footerLinks,
  hours,
  instagram,
  mailingAddress,
  phoneDisplay,
  phoneTel,
  serviceArea,
} from '../data/site';
---

<footer class="bg-ink text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[auto_1fr]">
    <a href="/" class="shrink-0">
      <img src="/img/logo-neri-inc.png" alt="Neri, Inc." width="180" height="48" class="h-12 w-auto" />
    </a>
    <div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-meta">
        {
          footerLinks.map((link) => (
            <li>
              <a class="hover:underline" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a class="hover:underline" href={phoneTel}>{phoneDisplay}</a>
        <span class="hidden h-5 w-0.5 bg-rule sm:block" aria-hidden="true"></span>
        <a class="hover:underline" href={emailHref}>{email}</a>
      </div>
      <p class="mt-4">{hours}</p>
      <p class="mt-2">{mailingAddress}</p>
      <p class="mt-4 max-w-3xl text-sm leading-6">
        <span class="font-meta uppercase tracking-wide">Service area. </span>
        {serviceArea}
      </p>
      <p class="mt-4 flex gap-4 font-meta">
        <a class="hover:underline" href={instagram} rel="noopener noreferrer">Instagram</a>
        <a class="hover:underline" href={facebook} rel="noopener noreferrer">Facebook</a>
      </p>
      <p class="mt-8 border-t border-rule/60 pt-4 text-sm">© Neri Inc., 2025-2026</p>
    </div>
  </div>
</footer>
